+        RawInput::rawInputState.sendKeyboardPressMessages = false;
+        FocusMessageLoop::PauseMessageLoop();
+        FakeCursor::EnableDisableFakeCursor(false);
+        current.state = Poisoned;
+        current.error = outcome.native_status ? outcome.native_status : ERROR_INVALID_DATA;
+        Publish();
+    }
+    const bool replied = PublishSetup(body, outcome);
+    return applied && replied;
