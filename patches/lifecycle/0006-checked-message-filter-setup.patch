+inline bool BeginChecked(HANDLE pipe, const ProtoMuxSetupAck::BeginV2& body)
+{
+    const uint64_t handles[]{body.base.remote_commit_mapping, body.base.remote_reply_mapping,
+        body.base.remote_event, body.mapping, body.event};
+    bool valid = true;
+    for (size_t i = 0; i < 5; ++i)
+    {
+        valid = valid && NativeHandle(handles[i]);
+        for (size_t j = 0; j < i; ++j) valid = valid && handles[i] != handles[j];
+    }
+    auto view = valid ? static_cast<ProtoMuxSetupAck::Reply*>(MapViewOfFile(Handle(body.mapping),
+        FILE_MAP_WRITE, 0, 0, sizeof(ProtoMuxSetupAck::Reply))) : nullptr;
+    valid = valid && view && view->magic == ProtoMuxSetupAck::ReplyMagic
+        && view->abi == ProtoMuxSetupAck::Version && view->bytes == sizeof(ProtoMuxSetupAck::Reply)
+        && view->creation == body.base.creation && view->generation == body.base.generation
+        && view->session == body.base.session && view->request == 0 && view->sequence == 0;
+    if (!valid)
+    {
+        if (view) UnmapViewOfFile(view);
+        // The complete frame transferred each distinct target-local handle once.
+        // ReplyTo consumes the base reply pair; never close aliases twice.
+        for (size_t i = 0; i < 5; ++i)
+        {
+            if (i == 1 || i == 2 || !NativeHandle(handles[i])
+                || handles[i] == handles[1] || handles[i] == handles[2]) continue;
+            bool first = true;
+            for (size_t j = 0; j < i; ++j) if (handles[j] == handles[i]) first = false;
+            if (first) CloseHandle(Handle(handles[i]));
+        }
+        ReplyTo(body.base.remote_reply_mapping, body.base.remote_event, Invalid,
+            body.base.generation, body.base.session);
+        return false;
+    }
+    if (!Begin(pipe, body.base))
+    {
+        UnmapViewOfFile(view);
+        CloseHandle(Handle(body.mapping));
+        CloseHandle(Handle(body.event));
+        return false;
+    }
+    CloseSetupChannel();
+    setupMapping = Handle(body.mapping);
+    setupEvent = Handle(body.event);
+    setupView = view;
+    return true;
+}
