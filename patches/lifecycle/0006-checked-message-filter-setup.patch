diff --git a/src/ProtoInput/ProtoInputHooks/pipeinclude/MuxSetupAckProtocol.h b/src/ProtoInput/ProtoInputHooks/pipeinclude/MuxSetupAckProtocol.h
new file mode 100644
--- /dev/null
+++ b/src/ProtoInput/ProtoInputHooks/pipeinclude/MuxSetupAckProtocol.h
@@ -0,0 +1,80 @@
+#pragma once
+#include <cstdint>
+#include "MuxLifecycleProtocol.h"
+
+// Narrow compatibility shim: the only checked operation is installing all four
+// MessageFilter detours. Rust retains authorization, deadlines and final commit.
+namespace ProtoMuxSetupAck
+{
+constexpr uint64_t Capability = 1;
+constexpr uint32_t Version = 1;
+constexpr uint32_t ReplyMagic = 0x4D585341;
+constexpr uint32_t MessageFilterHook = 2;
+enum Result : uint32_t { Applied = 1, AlreadyApplied, Invalid, StaleGeneration,
+    DuplicateConflict, NativeFailure, Dirty };
+struct BeginV2
+{
+    ProtoMuxLifecycle::BeginPacket base;
+    uint64_t mapping, event;
+};
+struct Install
+{
+    uint64_t creation, generation, session, request;
+    uint32_t hook, operation;
+    uint64_t reserved;
+};
+struct Reply
+{
+    uint32_t magic, abi, bytes, sequence;
+    uint64_t creation, generation, session, request;
+    uint32_t result, native_status, hook, reserved;
+};
+struct Outcome { uint32_t result, native_status; };
+struct Detours { bool any, all; };
+static_assert(sizeof(BeginV2) == 64, "setup BeginV2 ABI");
+static_assert(sizeof(Install) == 48, "setup install ABI");
+static_assert(sizeof(Reply) == 64, "setup reply ABI");
+
+// No reset of the sticky lifecycle error is allowed between Begin and retirement.
+template<class InstallFn, class DetoursFn, class ErrorFn>
+Outcome CheckInstall(InstallFn install, DetoursFn detours, ErrorFn error)
+{
+    const auto previousError = error();
+    if (previousError) return { Dirty, previousError };
+    const auto previous = detours();
+    if (previous.all) return { AlreadyApplied, 0 };
+    if (previous.any) return { Dirty, 0 };
+    install();
+    const auto after = detours();
+    const auto status = error();
+    return status || !after.all
+        ? Outcome{ NativeFailure, status ? status : 0xC0000001u }
+        : Outcome{ Applied, 0 };
+}
+
+// Frames carry no handles. An identical duplicate can safely republish its
+// cached result; a conflicting duplicate never invokes native installation.
+class Ledger
+{
+    Install last{};
+    Outcome cached{};
+public:
+    template<class Apply>
+    Outcome Run(const Install& body, uint64_t creation, uint64_t generation,
+        uint64_t session, Apply apply)
+    {
+        if (body.creation != creation || body.generation != generation || body.session != session)
+            return { StaleGeneration, 0 };
+        if (!body.request) return { Invalid, 0 };
+        if (body.request == last.request)
+            return body.hook == last.hook && body.operation == last.operation && body.reserved == last.reserved
+                ? cached : Outcome{ DuplicateConflict, 0 };
+        if (body.hook != MessageFilterHook || body.operation != 1 || body.reserved)
+            return { Invalid, 0 };
+        if (body.request != last.request + 1) return { Invalid, 0 };
+        last = body;
+        cached = apply();
+        return cached;
+    }
+};
+}
