+bool MessageFilterHook::RegisterQueueFence(HWND hwnd, HANDLE event, uint64_t cookie)
+{
+	if (event == nullptr)
+		return false;
+	auto reject = [event]()
+	{
+		CloseHandle(event);
+		return false;
+	};
+	if (hwnd == nullptr || cookie == 0 || !IsWindow(hwnd))
+		return reject();
+
+	DWORD owningPid = 0;
+	if (GetWindowThreadProcessId(hwnd, &owningPid) == 0 || owningPid != GetCurrentProcessId())
+		return reject();
+
+	const UINT message = QueueFenceMessage();
+	if (message == 0)
+		return reject();
+
+	{
+		std::lock_guard<std::mutex> lock(queueFenceMutex);
+		if (queueFences.size() >= 4096 || queueFences.find(cookie) != queueFences.end())
+			return reject();
+		queueFences.emplace(cookie, QueueFenceEntry{ hwnd, event });
+		if (std::find(lifecycleRecipients.begin(), lifecycleRecipients.end(), hwnd) == lifecycleRecipients.end()
+			&& lifecycleRecipients.size() < 4096)
+			lifecycleRecipients.push_back(hwnd);
+	}
+
+	if (!PostMessageW(hwnd, message, static_cast<WPARAM>(static_cast<uint32_t>(cookie)),
+		static_cast<LPARAM>(static_cast<uint32_t>(cookie >> 32))))
+	{
+		HANDLE registeredEvent = nullptr;
+		{
+			std::lock_guard<std::mutex> lock(queueFenceMutex);
+			const auto found = queueFences.find(cookie);
+			if (found != queueFences.end() && found->second.hwnd == hwnd && found->second.event == event)
+			{
+				registeredEvent = found->second.event;
+				queueFences.erase(found);
+			}
+		}
+		if (registeredEvent != nullptr)
+			CloseHandle(registeredEvent);
+		return false;
+	}
+
+	return true;
+}
+
+bool MessageFilterHook::HasPendingFences()
+{
+	std::lock_guard<std::mutex> lock(queueFenceMutex);
+	return !queueFences.empty();
+}
+
+void MessageFilterHook::WakeLifecycleRecipients()
+{
+	std::lock_guard<std::mutex> lock(queueFenceMutex);
+	for (const auto hwnd : lifecycleRecipients)
+	{
+		DWORD pid = 0;
+		if (GetWindowThreadProcessId(hwnd, &pid) && pid == GetCurrentProcessId())
