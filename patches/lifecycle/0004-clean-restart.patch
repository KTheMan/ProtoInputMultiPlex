+bool MessageFilterHook::FilterQueueFence(MSG* message, bool removed)
+{
+	const UINT fenceMessage = QueueFenceMessage();
+	if (message == nullptr || fenceMessage == 0 || message->message != fenceMessage)
+		return false;
+
+	const uint64_t cookie = static_cast<uint32_t>(message->wParam)
+		| (static_cast<uint64_t>(static_cast<uint32_t>(message->lParam)) << 32);
+	HANDLE event = nullptr;
+	{
+		std::lock_guard<std::mutex> lock(queueFenceMutex);
+		const auto found = queueFences.find(cookie);
+		if (found == queueFences.end() || found->second.hwnd != message->hwnd)
+			return false;
+		if (removed)
+		{
+			event = found->second.event;
+			queueFences.erase(found);
+		}
+	}
+
+	if (event != nullptr)
+	{
+		SetEvent(event);
+		CloseHandle(event);
+	}
+
+	// Hide the private marker from application message consumers. For PM_NOREMOVE,
+	// only the returned copy is changed; the queue entry and event remain pending.
+	message->hwnd = nullptr;
+	message->message = WM_NULL;
+	message->wParam = 0;
+	message->lParam = 0;
+	message->time = 0;
+	message->pt = POINT{};
+	return true;
+}
