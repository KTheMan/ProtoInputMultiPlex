@@ -0,0 +1,48 @@
+#pragma once
+#include <cstdint>
+
+// Passive, fixed-width lifecycle transport. All ownership policy and final
+// all-target commitment belong to Rust. Remote handles belong to the target.
+namespace ProtoMuxLifecycle
+{
+constexpr uint32_t Version = 1;
+constexpr uint64_t Build = 0x2026101500000001ULL;
+constexpr uint32_t ReadyMagic = 0x4D585244;
+constexpr uint32_t CommitMagic = 0x4D58434D;
+constexpr uint32_t ReplyMagic = 0x4D585250;
+enum State : uint32_t { Initializing, Unclaimed, Active, Prepared, Poisoned, Reusable };
+enum Result : uint32_t { Ok = 1, Busy, Dirty, Incompatible, CleanupFailed, Invalid };
+
+struct Commit
+{
+    uint32_t magic, abi, bytes, state;
+    uint64_t session, reserved[5];
+};
+struct Ready
+{
+    uint32_t magic, abi, bytes, sequence;
+    uint32_t state, owner_pid, bits, error;
+    uint64_t creation, generation, session, build;
+    uint64_t reserved[8];
+};
+struct Reply
+{
+    uint32_t magic, abi, bytes, result;
+    uint64_t creation, generation, session;
+    uint32_t native_state, error;
+    uint64_t reserved[2];
+};
+struct BeginPacket
+{
+    uint64_t creation, generation, session, remote_commit_mapping, remote_reply_mapping, remote_event;
+};
+struct RetirePacket
+{
+    uint64_t generation, session, remote_reply_mapping, remote_event;
+};
+static_assert(sizeof(Commit) == 64, "lifecycle commit ABI");
+static_assert(sizeof(Ready) == 128, "lifecycle ready ABI");
+static_assert(sizeof(Reply) == 64, "lifecycle reply ABI");
+static_assert(sizeof(BeginPacket) == 48, "lifecycle Begin ABI");
+static_assert(sizeof(RetirePacket) == 32, "lifecycle retire ABI");
+}
