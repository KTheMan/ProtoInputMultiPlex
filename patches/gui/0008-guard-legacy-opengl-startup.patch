+static bool IsWglProcAvailable(PROC address)
+{
+    // Windows drivers can use small integers or -1 as unavailable sentinels.
+    const auto value = reinterpret_cast<std::uintptr_t>(address);
+    return value > 3 && value != static_cast<std::uintptr_t>(-1);
 }
 
