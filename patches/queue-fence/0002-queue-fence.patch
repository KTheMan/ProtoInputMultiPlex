+	bool TargetUses64BitHandles(unsigned long pid)
+	{
+		HANDLE process = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid);
+		if (process == nullptr)
+			return false;
+
+		BOOL isWow64 = FALSE;
+		const BOOL queried = IsWow64Process(process, &isWow64);
+		CloseHandle(process);
+		if (!queried)
+			return false;
+
+		SYSTEM_INFO systemInfo{};
+		GetNativeSystemInfo(&systemInfo);
+		const bool nativeIs32Bit = systemInfo.wProcessorArchitecture == PROCESSOR_ARCHITECTURE_INTEL;
+		return !isWow64 && !nativeIs32Bit;
+	}
+}
