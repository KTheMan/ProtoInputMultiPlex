+extern "C" __declspec(dllexport) unsigned int MuxInputVersion() { return 3; }
+
+extern "C" __declspec(dllexport) void MuxSubmitInput(ProtoInstanceHandle instanceHandle, const ProtoPipe::MuxInputPacket* packet)
+{
+	if (packet == nullptr) return;
+	if (auto found = Proto::instances.find(instanceHandle); found != Proto::instances.end())
+	{
+		WaitClientConnect(found->second);
+		auto body = *packet;
+		ProtoSendPipeMessage(found->second.pipeHandle, ProtoPipe::PipeMessageType::MuxInput, &body);
+	}
+}
+
+extern "C" __declspec(dllexport) bool MuxQueueFence(ProtoInstanceHandle instanceHandle,
+	uint64_t hwnd, uint64_t remote_event, uint64_t cookie)
+{
+	if (hwnd == 0 || remote_event == 0 || cookie == 0)
+		return false;
+
+	const auto found = Proto::instances.find(instanceHandle);
+	if (found == Proto::instances.end())
+		return false;
+
+	auto& instance = found->second;
+	if (instance.pipeHandle == nullptr || instance.pipeHandle == INVALID_HANDLE_VALUE)
+		return false;
+	const auto nativeHwnd = reinterpret_cast<HWND>(static_cast<uintptr_t>(hwnd));
+	if (static_cast<uint64_t>(reinterpret_cast<uintptr_t>(nativeHwnd)) != hwnd)
+		return false;
+
+	DWORD owningPid = 0;
+	if (GetWindowThreadProcessId(nativeHwnd, &owningPid) == 0 || owningPid != instance.pid)
+		return false;
+
+	if (!TargetUses64BitHandles(instance.pid)
+		&& ((hwnd >> 32) != 0 || (remote_event >> 32) != 0))
+		return false;
+
+	WaitClientConnect(instance);
+	if (!instance.clientConnected)
+		return false;
+	ProtoPipe::PipeMessageHeader header{
+		ProtoPipe::PipeMessageType::MuxQueueFence,
+		static_cast<unsigned int>(sizeof(ProtoPipe::MuxQueueFencePacket))
+	};
+	ProtoPipe::MuxQueueFencePacket body{ hwnd, remote_event, cookie };
+
+	// A failed or partial write may still have reached the target. After starting the
+	// transfer, ownership is therefore treated as transferred and Rust resolves failure
+	// through its bounded timeout rather than closing a possibly live target handle.
+	std::lock_guard<std::mutex> lock(ProtoPipeWriteMutex());
+	DWORD written = 0;
+	const BOOL headerWritten = WriteFile(instance.pipeHandle, &header, sizeof(header), &written, nullptr);
+	if (!headerWritten || written != sizeof(header))
+		return true;
+
+	written = 0;
+	const BOOL bodyWritten = WriteFile(instance.pipeHandle, &body, sizeof(body), &written, nullptr);
+	if (!bodyWritten || written != sizeof(body))
+		return true;
+
+	return true;
+}
+
+namespace
+{
+    template<typename Body>
+    bool SendCursorCommand(ProtoInstanceHandle handle, ProtoPipe::PipeMessageType type, const Body& body)
+    {
+        const auto found = Proto::instances.find(handle);
+        if (found == Proto::instances.end()) return false;
+        auto& instance = found->second;
+        if (!instance.pipeHandle || instance.pipeHandle == INVALID_HANDLE_VALUE) return false;
+        WaitClientConnect(instance);
+        if (!instance.clientConnected) return false;
+        const ProtoPipe::PipeMessageHeader header{ type, static_cast<unsigned int>(sizeof(Body)) };
+        std::lock_guard<std::mutex> lock(ProtoPipeWriteMutex());
+        DWORD written = 0;
+        // As with queue fences, once writing begins Start transfers ownership even
+        // on a partial failure. Rust must not close a potentially consumed handle.
+        if (!WriteFile(instance.pipeHandle, &header, sizeof(header), &written, nullptr) || written != sizeof(header)) return true;
+        written = 0;
+        WriteFile(instance.pipeHandle, &body, sizeof(body), &written, nullptr);
+        return true;
+    }
+}
+extern "C" __declspec(dllexport) unsigned int MuxCursorObserverVersion() { return 1; }
+extern "C" __declspec(dllexport) bool MuxCursorObserverStart(ProtoInstanceHandle instance, uint64_t mapping, uint64_t mutex, uint64_t attachment)
+{
+    const auto found = Proto::instances.find(instance);
+    if (found == Proto::instances.end() || !mapping || !mutex || !attachment) return false;
+    if (!TargetUses64BitHandles(found->second.pid) && ((mapping >> 32) || (mutex >> 32))) return false;
+    return SendCursorCommand(instance, ProtoPipe::PipeMessageType::MuxCursorObserverStart, ProtoPipe::MuxCursorObserverStartPacket{mapping, mutex, attachment});
+}
+extern "C" __declspec(dllexport) bool MuxCursorObserverAssociate(ProtoInstanceHandle instance, uint64_t hwnd, uint64_t association)
+{
+    const auto found = Proto::instances.find(instance);
+    if (found == Proto::instances.end() || !hwnd || !association) return false;
+    const auto native = reinterpret_cast<HWND>(static_cast<uintptr_t>(hwnd));
+    if (static_cast<uint64_t>(reinterpret_cast<uintptr_t>(native)) != hwnd) return false;
+    DWORD pid = 0;
+    if (!GetWindowThreadProcessId(native, &pid) || pid != found->second.pid) return false;
+    return SendCursorCommand(instance, ProtoPipe::PipeMessageType::MuxCursorObserverAssociate, ProtoPipe::MuxCursorObserverAssociatePacket{hwnd, association});
+}
+extern "C" __declspec(dllexport) bool MuxCursorObserverStop(ProtoInstanceHandle instance, uint64_t attachment)
+{
+    if (!attachment) return false;
+    return SendCursorCommand(instance, ProtoPipe::PipeMessageType::MuxCursorObserverStop, ProtoPipe::MuxCursorObserverStopPacket{attachment});
+}
 
