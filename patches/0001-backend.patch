--- /dev/null
+++ b/src/ProtoInput/ProtoInputHooks/MuxCursorObserverBridge.h
@@ -0,0 +1,98 @@
+#pragma once
+#include <Windows.h>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+// Optional forwarding only. Cursor ownership, conversion and publication are Rust.
+// Keep the DLL loaded until target exit: a hook may already hold a function pointer.
+namespace Proto::MuxCursorObserverBridge
+{
+// Rust observer result ABI: 0=success; 1=disabled; 2=busy; 3=invalid; 4=capture failure.
+inline constexpr uint32_t ObserverSuccess = 0;
+using StartFn = uint32_t (__cdecl*)(uint64_t, uint64_t, uint32_t, uint64_t);
+using AssociateFn = uint32_t (__cdecl*)(uint64_t, uint64_t);
+using NotifyFn = uint32_t (__cdecl*)(uint64_t, uint32_t, uint64_t);
+using MotionFn = uint32_t (__cdecl*)(uint64_t);
+using StopFn = uint32_t (__cdecl*)(uint64_t);
+inline std::once_flag loadOnce;
+inline StartFn startFn = nullptr;
+inline AssociateFn associateFn = nullptr;
+inline StopFn stopFn = nullptr;
+inline std::atomic<NotifyFn> notifyFn{ nullptr };
+inline std::atomic<MotionFn> motionFn{ nullptr };
+inline uint64_t activeAttachment = 0; // command pipe thread only
+
+inline void Load()
+{
+	std::call_once(loadOnce, [] {
+		HMODULE own = nullptr;
+		if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+			reinterpret_cast<LPCWSTR>(&Load), &own)) return;
+		wchar_t filename[32768]{};
+		const DWORD length = GetModuleFileNameW(own, filename, 32768);
+		if (length == 0 || length >= 32768) return;
+		std::wstring path(filename, length);
+		const auto slash = path.find_last_of(L"\\/");
+		if (slash == std::wstring::npos) return;
+		path.resize(slash + 1);
+#ifdef _WIN64
+		path += L"protoinputmultiplex_cursor_observer64.dll";
+#else
+		path += L"protoinputmultiplex_cursor_observer32.dll";
+#endif
+		const HMODULE module = LoadLibraryExW(path.c_str(), nullptr,
+			LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+		if (!module) return;
+		const auto start = reinterpret_cast<StartFn>(GetProcAddress(module, "ProtoMuxCursorObserverStart"));
+		const auto associate = reinterpret_cast<AssociateFn>(GetProcAddress(module, "ProtoMuxCursorObserverAssociate"));
+		const auto notify = reinterpret_cast<NotifyFn>(GetProcAddress(module, "ProtoMuxCursorObserverNotify"));
+		const auto motion = reinterpret_cast<MotionFn>(GetProcAddress(module, "ProtoMuxCursorObserverMotion"));
+		const auto stop = reinterpret_cast<StopFn>(GetProcAddress(module, "ProtoMuxCursorObserverStop"));
+		if (!start || !associate || !notify || !motion || !stop) return;
+		startFn = start;
+		associateFn = associate;
+		stopFn = stop;
+		motionFn.store(motion, std::memory_order_release);
+		notifyFn.store(notify, std::memory_order_release);
+	});
+}
+
+inline void Start(uint64_t mapping, uint64_t mutex, uint64_t attachment)
+{
+	Load();
+	if (!startFn) {
+		if (mapping) CloseHandle(reinterpret_cast<HANDLE>(static_cast<uintptr_t>(mapping)));
+		if (mutex) CloseHandle(reinterpret_cast<HANDLE>(static_cast<uintptr_t>(mutex)));
+		return;
+	}
+	// The Rust export consumes both remote handles on every result.
+	if (startFn(mapping, mutex, GetCurrentProcessId(), attachment) == ObserverSuccess)
+		activeAttachment = attachment;
+}
+inline void Associate(uint64_t hwnd, uint64_t epoch)
+{
+	if (associateFn && activeAttachment) associateFn(hwnd, epoch);
+}
+inline void Notify(HCURSOR cursor, bool visible, intptr_t selectedHwnd)
+{
+	if (const auto notify = notifyFn.load(std::memory_order_acquire))
+		notify(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(cursor)), visible ? 1U : 0U,
+			static_cast<uint64_t>(static_cast<uintptr_t>(selectedHwnd)));
+}
+inline void Motion(intptr_t selectedHwnd)
+{
+	if (const auto motion = motionFn.load(std::memory_order_acquire))
+		motion(static_cast<uint64_t>(static_cast<uintptr_t>(selectedHwnd)));
+}
+inline void Stop(uint64_t attachment)
+{
+	if (stopFn && attachment && attachment == activeAttachment) {
+		// A failed Stop retains the attachment so pipe EOF can retry cleanup.
+		if (stopFn(attachment) == ObserverSuccess)
+			activeAttachment = 0;
+	}
+}
+inline void StopAll() { Stop(activeAttachment); }
+}
