 namespace Proto
 {
 
+namespace
+{
+struct QueueFenceEntry
+{
+	HWND hwnd;
+	HANDLE event;
+};
+
+std::mutex queueFenceMutex;
+std::unordered_map<uint64_t, QueueFenceEntry> queueFences;
+
+UINT QueueFenceMessage()
+{
+	static const UINT message = RegisterWindowMessageW(L"ProtoInputMultiPlex.QueueFence.V1");
+	return message;
+}
+}
+
+bool MessageFilterHook::RegisterQueueFence(HWND hwnd, HANDLE event, uint64_t cookie)
+{
+	if (event == nullptr)
+		return false;
+	auto reject = [event]()
+	{
+		CloseHandle(event);
+		return false;
+	};
+	if (hwnd == nullptr || cookie == 0 || !IsWindow(hwnd))
+		return reject();
+
+	DWORD owningPid = 0;
+	if (GetWindowThreadProcessId(hwnd, &owningPid) == 0 || owningPid != GetCurrentProcessId())
+		return reject();
+
+	const UINT message = QueueFenceMessage();
+	if (message == 0)
+		return reject();
+
+	{
+		std::lock_guard<std::mutex> lock(queueFenceMutex);
+		if (queueFences.size() >= 4096 || queueFences.find(cookie) != queueFences.end())
+			return reject();
+		queueFences.emplace(cookie, QueueFenceEntry{ hwnd, event });
+	}
+
+	if (!PostMessageW(hwnd, message, static_cast<WPARAM>(static_cast<uint32_t>(cookie)),
+		static_cast<LPARAM>(static_cast<uint32_t>(cookie >> 32))))
+	{
+		HANDLE registeredEvent = nullptr;
+		{
+			std::lock_guard<std::mutex> lock(queueFenceMutex);
+			const auto found = queueFences.find(cookie);
+			if (found != queueFences.end() && found->second.hwnd == hwnd && found->second.event == event)
+			{
+				registeredEvent = found->second.event;
+				queueFences.erase(found);
+			}
+		}
+		if (registeredEvent != nullptr)
+			CloseHandle(registeredEvent);
+		return false;
+	}
+
+	return true;
+}
+
+bool MessageFilterHook::HasPendingFences()
+{
+	std::lock_guard<std::mutex> lock(queueFenceMutex);
+	return !queueFences.empty();
+}
+
+bool MessageFilterHook::FilterQueueFence(MSG* message, bool removed)
+{
+	const UINT fenceMessage = QueueFenceMessage();
+	if (message == nullptr || fenceMessage == 0 || message->message != fenceMessage)
+		return false;
+
+	const uint64_t cookie = static_cast<uint32_t>(message->wParam)
+		| (static_cast<uint64_t>(static_cast<uint32_t>(message->lParam)) << 32);
+	HANDLE event = nullptr;
+	{
+		std::lock_guard<std::mutex> lock(queueFenceMutex);
+		const auto found = queueFences.find(cookie);
+		if (found == queueFences.end() || found->second.hwnd != message->hwnd)
+			return false;
+		if (removed)
+		{
+			event = found->second.event;
+			queueFences.erase(found);
+		}
+	}
+
+	if (event != nullptr)
+	{
+		SetEvent(event);
+		CloseHandle(event);
+	}
+
+	// Hide the private marker from application message consumers. For PM_NOREMOVE,
+	// only the returned copy is changed; the queue entry and event remain pending.
+	message->hwnd = nullptr;
+	message->message = WM_NULL;
+	message->wParam = 0;
+	message->lParam = 0;
+	message->time = 0;
+	message->pt = POINT{};
+	return true;
+}
