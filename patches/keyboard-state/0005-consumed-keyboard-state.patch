diff --git a/src/ProtoInput/ProtoInputHooks/MuxKeyboardStateBridge.h b/src/ProtoInput/ProtoInputHooks/MuxKeyboardStateBridge.h
new file mode 100644
--- /dev/null
+++ b/src/ProtoInput/ProtoInputHooks/MuxKeyboardStateBridge.h
@@ -0,0 +1,126 @@
+#pragma once
+#include <Windows.h>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include "FakeMouseKeyboard.h"
+
+// Facts-only adapter. The Rust provider owns consumed keyboard state and
+// publication. Keep this module loaded until process exit: hooks may be live.
+namespace Proto::MuxKeyboardStateBridge
+{
+inline constexpr uint32_t Ok = 0;
+inline constexpr uint32_t Disabled = 1;
+inline constexpr uint32_t Invalid = 3;
+using VersionFn = uint32_t (__cdecl*)();
+using StartFn = uint32_t (__cdecl*)(uint64_t);
+using StopFn = uint32_t (__cdecl*)(uint64_t);
+using MessageFn = uint32_t (__cdecl*)(uint32_t, uint64_t, uint64_t, uint32_t, uint32_t, uint32_t, uint32_t);
+using GetKeyStateFn = uint32_t (__cdecl*)(int32_t, uint32_t, int16_t*);
+using GetKeyboardStateFn = uint32_t (__cdecl*)(uint32_t, uint8_t*);
+
+inline std::once_flag loadOnce;
+inline std::atomic<StartFn> startFn{nullptr};
+inline std::atomic<StopFn> stopFn{nullptr};
+inline std::atomic<MessageFn> messageFn{nullptr};
+inline std::atomic<GetKeyStateFn> getKeyStateFn{nullptr};
+inline std::atomic<GetKeyboardStateFn> getKeyboardStateFn{nullptr};
+inline std::atomic<uint64_t> activeEpoch{0};
+
+inline void Load()
+{
+    std::call_once(loadOnce, [] {
+        HMODULE own = nullptr;
+        if (!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+            reinterpret_cast<LPCWSTR>(&Load), &own)) return;
+        wchar_t filename[32768]{};
+        const DWORD length = GetModuleFileNameW(own, filename, 32768);
+        if (!length || length >= 32768) return;
+        std::wstring path(filename, length);
+        const auto slash = path.find_last_of(L"\\/");
+        if (slash == std::wstring::npos) return;
+        path.resize(slash + 1);
+#ifdef _WIN64
+        path += L"protoinputmultiplex_cursor_observer64.dll";
+#else
+        path += L"protoinputmultiplex_cursor_observer32.dll";
+#endif
+        const HMODULE module = LoadLibraryExW(path.c_str(), nullptr,
+            LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+        if (!module) return;
+        const auto version = reinterpret_cast<VersionFn>(GetProcAddress(module, "ProtoMuxKeyboardVersion"));
+        const auto start = reinterpret_cast<StartFn>(GetProcAddress(module, "ProtoMuxKeyboardStart"));
+        const auto stop = reinterpret_cast<StopFn>(GetProcAddress(module, "ProtoMuxKeyboardStop"));
+        const auto message = reinterpret_cast<MessageFn>(GetProcAddress(module, "ProtoMuxKeyboardMessage"));
+        const auto getKey = reinterpret_cast<GetKeyStateFn>(GetProcAddress(module, "ProtoMuxKeyboardGetKeyState"));
+        const auto getKeyboard = reinterpret_cast<GetKeyboardStateFn>(GetProcAddress(module, "ProtoMuxKeyboardGetKeyboardState"));
+        if (!version || !start || !stop || !message || !getKey || !getKeyboard || version() != 1) return;
+        // Publish start last, only after every required export passed validation.
+        stopFn.store(stop, std::memory_order_release);
+        messageFn.store(message, std::memory_order_release);
+        getKeyStateFn.store(getKey, std::memory_order_release);
+        getKeyboardStateFn.store(getKeyboard, std::memory_order_release);
+        startFn.store(start, std::memory_order_release);
+    });
+}
+
+inline uint32_t MouseBits()
+{
+    uint32_t bits = 0;
+    if (FakeMouseKeyboard::IsKeyStatePressed(VK_LBUTTON)) bits |= 1U << 0;
+    if (FakeMouseKeyboard::IsKeyStatePressed(VK_RBUTTON)) bits |= 1U << 1;
+    if (FakeMouseKeyboard::IsKeyStatePressed(VK_MBUTTON)) bits |= 1U << 2;
+    if (FakeMouseKeyboard::IsKeyStatePressed(VK_XBUTTON1)) bits |= 1U << 3;
+    if (FakeMouseKeyboard::IsKeyStatePressed(VK_XBUTTON2)) bits |= 1U << 4;
+    return bits;
+}
+inline uint32_t Start(uint64_t epoch)
+{
+    Load();
+    const auto start = startFn.load(std::memory_order_acquire);
+    if (!start) return Disabled;
+    const uint32_t status = start(epoch);
+    if (status == Ok) activeEpoch.store(epoch, std::memory_order_release);
+    return status;
+}
+inline uint32_t Stop(uint64_t epoch)
+{
+    const uint64_t active = activeEpoch.load(std::memory_order_acquire);
+    if (!active) return Disabled;
+    if (!epoch || epoch != active) return Invalid;
+    const auto stop = stopFn.load(std::memory_order_acquire);
+    if (!stop) return Invalid;
+    const uint32_t status = stop(epoch);
+    if (status == Ok) activeEpoch.store(0, std::memory_order_release);
+    return status;
+}
+inline uint32_t Message(const MSG& original, bool removed, bool allowed, bool fence)
+{
+    const auto message = messageFn.load(std::memory_order_acquire);
+    if (!message) return Disabled;
+    return message(original.message, static_cast<uint64_t>(original.wParam),
+        static_cast<uint64_t>(static_cast<uintptr_t>(original.lParam)),
+        removed ? 1U : 0U, allowed ? 1U : 0U, MouseBits(), fence ? 1U : 0U);
+}
+inline uint32_t GetKeyState(int vkey, int16_t* out)
+{
+    const auto get = getKeyStateFn.load(std::memory_order_acquire);
+    return get ? get(vkey, MouseBits(), out) : Disabled;
+}
+inline uint32_t GetKeyboardState(uint8_t* out)
+{
+    const auto get = getKeyboardStateFn.load(std::memory_order_acquire);
+    return get ? get(MouseBits(), out) : Disabled;
+}
+inline uint32_t StopAll() { return Stop(activeEpoch.load(std::memory_order_acquire)); }
+inline bool QuiescentForLifecycle()
+{
+    StopAll();
+    return activeEpoch.load(std::memory_order_acquire) == 0;
+}
+inline bool FenceMayAck(uint32_t status)
+{
+    return status == Ok || (status == Disabled && activeEpoch.load(std::memory_order_acquire) == 0);
+}
+}
