  "tools": [
    {
      "name": "automation_cancel",
      "description": "Cancel recording or playback and release macro-held virtual input. Keeps the agent routing session available.",
      "inputSchema": {
        "properties": {},
        "type": "object"
      }
    },
    {
      "name": "automation_clip",
      "description": "Inspect the current virtual-input clip or load a serialized clip into this local agent session. Loading does not play it.",
      "inputSchema": {
        "$defs": {
          "ClipAction": {
            "enum": [
              "inspect",
              "load"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "action": {
            "$ref": "#/$defs/ClipAction"
          },
          "clip": {
            "description": "Serialized automation clip. Required for load and ignored for inspect."
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    },
    {
      "name": "automation_play",
      "description": "Play the loaded macro on this session's app-local virtual users. Playback remains scoped to the session's authorized target processes and never injects global desktop input.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "loops": {
            "description": "Number of play-throughs; omitted means repeat until cancelled.",
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "speed": {
            "description": "Playback multiplier. Must be finite and positive.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "speed"
        ],
        "type": "object"
      }
    },
    {
      "name": "automation_record",
      "description": "Start or stop recording this agent session's virtual mouse and keyboard stream. Recording only captures this session's inputs; it does not observe global desktop input.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "recording": {
            "type": "boolean"
          }
        },
        "required": [
          "recording"
        ],
        "type": "object"
      }
    },
    {
      "name": "routing_displays",
      "description": "Read the virtual desktop bounds and connected display monitors, including stable monitor interface paths when Windows provides them. This read-only inventory does not load ProtoInput, change displays, or return transient monitor handles. Adapter-name fallbacks are explicitly marked unverified and cannot be persisted as monitor selections.",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "routing_input",
      "description": "Operate an app-local virtual device. User indices start at zero; coordinates are physical desktop pixels. Press or release primary, secondary, middle, back or forward buttons; scroll vertically (default) or horizontally; use named keys or validated Unicode text. Returns worker state after acknowledgement. Inspect user status and target to verify delivery. Never moves the OS pointer or injects global input.",
      "inputSchema": {
        "$defs": {
          "Button": {
            "enum": [
              "primary",
              "secondary",
              "middle",
              "back",
              "forward"
            ],
            "type": "string"
          },
          "WheelAxis": {
            "enum": [
              "vertical",
              "horizontal"
            ],
            "type": "string"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "description": "Absolute virtual desktop coordinates; never moves the OS pointer.",
            "properties": {
              "action": {
                "const": "move_to",
                "type": "string"
              },
              "user": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              },
              "x": {
                "format": "int32",
                "type": "integer"
              },
              "y": {
                "format": "int32",
                "type": "integer"
              }
            },
            "required": [
              "action",
              "user",
              "x",
              "y"
            ],
            "type": "object"
          },
          {
            "properties": {
              "action": {
                "const": "motion",
                "type": "string"
              },
              "dx": {
                "format": "int32",
                "type": "integer"
              },
              "dy": {
                "format": "int32",
                "type": "integer"
              },
              "user": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "action",
              "user",
              "dx",
              "dy"
            ],
            "type": "object"
          },
          {
            "properties": {
              "action": {
                "const": "button",
                "type": "string"
              },
              "button": {
                "$ref": "#/$defs/Button"
              },
              "pressed": {
                "type": "boolean"
              },
              "user": {
                "format": "uint",
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "action",
              "user",
              "button",
              "pressed"
            ],
