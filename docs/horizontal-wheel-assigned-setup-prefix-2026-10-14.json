erties": {}, "type": "object"}}, {"name": "automation_clip", "description": "Inspect the legacy composite clip or load a serialized clip into this local agent session. Loading does not play it and is rejected while any independent Macro Studio lane is recording or playing.", "inputSchema": {"$defs": {"ClipAction": {"enum": ["inspect", "load"], "type": "string"}}, "$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"action": {"$ref": "#/$defs/ClipAction"}, "clip": {"description": "Serialized automation clip. Required for load and ignored for inspect."}}, "required": ["action"], "type": "object"}}, {"name": "automation_play", "description": "Play the loaded legacy composite macro across this session's app-local virtual users on one session-wide clock. Playback is rejected while any independent Macro Studio lane is recording or playing, remains scoped to authorized target processes, and never injects global desktop input.", "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"loops": {"description": "Number of play-throughs; omitted means repeat until cancelled.", "format": "uint32", "minimum": 0, "type": ["integer", "null"]}, "speed": {"description": "Playback multiplier. Must be finite and positive.", "format": "double", "type": "number"}}, "required": ["speed"], "type": "object"}}, {"name": "automation_record", "description": "Start or stop the legacy composite recorder, which records a session-wide stream across users on one clock. Recording only captures this session's virtual inputs; it does not observe global desktop input. Starting recording is rejected while any independent Macro Studio lane is recording or playing.", "inputSchema": {"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "properties": {"recording": {"type": "boolean"}}, "required": ["recording"], "type": "object"}}, {"name": "macro_studio"